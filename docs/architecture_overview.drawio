  <diagram id="minutes-quality" name="Minutes quality controls">
    <mxGraphModel dx="1760" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="q-title" value="Minutes quality pipeline · experimental Sprint 2 candidate" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=29;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="70" y="35" width="1500" height="55" as="geometry"/></mxCell>
        <mxCell id="q-subtitle" value="Local Swift + Qwen3 30B via MLX Swift / Metal · raw transcript stays immutable · failed stages do not replace the last saved record" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="72" y="92" width="1550" height="35" as="geometry"/></mxCell>
        <mxCell id="q-raw" value="&lt;b&gt;1. Raw timed transcript&lt;/b&gt;&lt;br&gt;Swift MeetingRecord&lt;br&gt;IDs, times, original words and speaker labels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#64748B;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="85" y="210" width="340" height="145" as="geometry"/></mxCell>
        <mxCell id="q-clean" value="&lt;b&gt;2. Transcript correction&lt;/b&gt;&lt;br&gt;Swift configurable reading layer&lt;br&gt;One saved segmentation profile&lt;br&gt;Speaker change ends the turn&lt;br&gt;Default: no time or pause cut&lt;br&gt;Neighbor joins need review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="515" y="210" width="340" height="145" as="geometry"/></mxCell>
        <mxCell id="q-topics" value="&lt;b&gt;3. Identify broad topics&lt;/b&gt;&lt;br&gt;Local Qwen3 30B / MLX&lt;br&gt;At most five topics with source utterances" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#312E81;" vertex="1" parent="1"><mxGeometry x="945" y="210" width="340" height="145" as="geometry"/></mxCell>
        <mxCell id="q-assign" value="&lt;b&gt;4. Assign every utterance&lt;/b&gt;&lt;br&gt;Local Qwen3 30B / MLX&lt;br&gt;One or more topics; Swift requires 100% coverage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#312E81;" vertex="1" parent="1"><mxGeometry x="1375" y="210" width="340" height="145" as="geometry"/></mxCell>
        <mxCell id="q-summaries" value="&lt;b&gt;5. Summarize each topic&lt;/b&gt;&lt;br&gt;Local Qwen3 30B / MLX&lt;br&gt;Readable prose + short verbatim evidence quote" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#312E81;" vertex="1" parent="1"><mxGeometry x="1375" y="515" width="340" height="145" as="geometry"/></mxCell>
        <mxCell id="q-items" value="&lt;b&gt;6. Extract meeting items&lt;/b&gt;&lt;br&gt;Decisions, actions, tasks, open questions&lt;br&gt;Explicit source words and cited IDs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#312E81;" vertex="1" parent="1"><mxGeometry x="945" y="515" width="340" height="145" as="geometry"/></mxCell>
        <mxCell id="q-gate" value="&lt;b&gt;Technical quality gate&lt;/b&gt;&lt;br&gt;Swift schema, size, IDs, evidence quote, source routing&lt;br&gt;At most two targeted model repairs per stage&lt;br&gt;Reject failure; keep previous record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#78350F;" vertex="1" parent="1"><mxGeometry x="515" y="515" width="340" height="145" as="geometry"/></mxCell>
        <mxCell id="q-save" value="&lt;b&gt;7. Reviewable draft&lt;/b&gt;&lt;br&gt;Atomic JSON save in MeetingStore&lt;br&gt;Human content and audio review before use" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="85" y="515" width="340" height="145" as="geometry"/></mxCell>
        <mxCell id="q-foot" value="Current evidence: unit and CLI contract tests pass; real-meeting minutes quality is still being measured. Source existence and verbatim evidence are machine checked; factual entailment needs human review." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="85" y="795" width="1570" height="90" as="geometry"/></mxCell>
