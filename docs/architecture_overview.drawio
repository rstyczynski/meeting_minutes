        <mxCell id="asr" value="&lt;b&gt;1 · Transcription (required)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Swift process adapters · FluidAudio / Core ML&lt;br&gt;Parakeet v2: English only · FastConformer-TDT&lt;br&gt;Parakeet v3: English + Polish · same ASR family&lt;br&gt;Whisper via whisper.cpp · C++ CPU tested&lt;br&gt;&lt;br&gt;Returns timed text; Swift makes record JSON" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="85" y="650" width="475" height="245" as="geometry"/></mxCell>
        <mxCell id="speaker" value="&lt;b&gt;2 · Speaker recognition (optional)&lt;/b&gt;&lt;br&gt;&lt;br&gt;FluidAudio offline diarizer · separate speech model&lt;br&gt;Audio input · S1/S2/S3 voice turns + warnings&lt;br&gt;Chair assigns names through CLI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2;dashed=1;dashPattern=6 4;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#115E59;" vertex="1" parent="1"><mxGeometry x="650" y="650" width="430" height="245" as="geometry"/></mxCell>
        <mxCell id="minutes" value="&lt;b&gt;3 · Meeting minutes (optional experiment)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Qwen 30B LLM via MLX Swift LM · Apple Metal&lt;br&gt;4B attempts retained as historical evidence&lt;br&gt;Adapter checks response syntax and citations&lt;br&gt;MeetingCore checks source grounding&lt;br&gt;&lt;b&gt;Real-meeting quality remains a delivery blocker&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;dashed=1;dashPattern=6 4;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#9A3412;" vertex="1" parent="1"><mxGeometry x="1170" y="650" width="480" height="245" as="geometry"/></mxCell>
        <mxCell id="legend" value="Solid flow: required/current path     Dashed flow: optional step     Engine output is local; no cloud service" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="85" y="940" width="1350" height="30" as="geometry"/></mxCell>
